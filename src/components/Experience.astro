---
// Renders from the handbook's career facts (site-career, W-11). Change the facts there.
import career from './site-career/career.json';

const job = career.person.experience[0];
const clients = career.clients.filter((client) => client.resume.length > 0);
---

<div class="col-md-8 mb-4">
  <div class="card h-100 animate-in animate-in-2">
    <div class="card-body">
      <h2 class="text-center" id="AboutMe">EXPERIENCE</h2>
      <hr />
      <h3>{job.employer}, {job.position}</h3>
      <p class="text-muted">{job.start} to present</p>

      <ul>
        {job.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>

      <h4 class="mt-4">Notable Clients</h4>

      {
        clients.map((client) => (
          <div class="client-card mb-3">
            <h5 class="card-title">
              {client.description}
              {client.role !== 'Consultant' && ` (${client.role})`}
            </h5>
            <h6 class="card-subtitle mb-2 text-muted">Technologies: {client.technologies.join(', ')}</h6>
            <ul>
              {client.resume.map((i) => (
                <li>{client.bullets[i].text}</li>
              ))}
            </ul>
          </div>
        ))
      }

      <h4 class="mt-4">Products</h4>

      {
        career.products.map((product) => (
          <div class="client-card mb-3">
            <h5 class="card-title">
              <a href={product.url} target="_blank" rel="noopener">
                {product.name}
              </a>
            </h5>
            <ul>
              {product.bullets.map((bullet) => (
                <li>{bullet.text}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</div>
