---
// Renders from the handbook's career facts (site-career, W-11). Change the facts there.
import career from './site-career/career.json';

const p = career.person;
---

<div class="col-md-4 mb-4">
  <div class="card h-100 animate-in animate-in-3">
    <div class="card-body">
      <h2 class="text-center">SKILLS</h2>
      <hr />
      {
        p.skills.map((group) => (
          <p>
            <strong>{group.group}:</strong> {group.items.join(', ')}
          </p>
        ))
      }
      <hr />

      <h2 class="text-center">Security Research</h2>
      <hr />
      <h3>Responsible Vulnerability Disclosures</h3>
      <ul>
        {
          p.vulnerabilities.map((v) => (
            <li>
              <a href={v.url} target="_blank">
                {v.id}
              </a>{' '}
              ({v.severity})
              <ul>
                <li>{v.summary}.</li>
                <li>{v.impact}.</li>
              </ul>
            </li>
          ))
        }
      </ul>

      <h3>Publications</h3>
      {
        p.publications.map((pub) => (
          <p>
            {pub.citation}{' '}
            <a href={pub.url} target="_blank">
              doi: {pub.doi}
            </a>
            .
          </p>
        ))
      }

      <h3>Competitions</h3>
      {
        p.competitions.map((c) => (
          <p>
            <strong>
              <a href={c.url} target="_blank">
                {c.name}
              </a>
            </strong>
            <br />
            {c.text}
          </p>
        ))
      }
      <hr />

      <h2 class="text-center">EDUCATION</h2>
      <ul class="list-unstyled">
        {
          p.education.map((e) => (
            <li class="mb-2">
              {e.school}, {e.location}: {e.degree}, GPA {e.gpa}
            </li>
          ))
        }
      </ul>
      <hr />

      <h2 class="text-center">AWARDS</h2>
      {
        p.recognition.map((r) => (
          <div>
            <p>{r.name}</p>
            <p>{r.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>
