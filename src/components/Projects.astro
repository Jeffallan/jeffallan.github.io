---
// Renders from the handbook's career facts (site-career, W-11). Change the facts there.
import career from './site-career/career.json';

const host = (url: string) => (url.includes('pypi.org') ? 'PyPI' : 'GitHub');
---

<div class="col-12 jumbotron">
  <h2 class="text-center" id="Projects">Open Source Projects</h2>
  <div class="row mt-5">
    {
      career.person.open_source.map((project) => (
        <div class="col-md-6 mb-3">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title">{project.name}</h5>
              <h6 class="card-subtitle mb-2 text-muted">
                {project.name === 'claude-skills' && (
                  <a href="https://github.com/hesreallyhim/awesome-claude-code">
                    <img src="https://awesome.re/mentioned-badge.svg" height="28" alt="Mentioned in Awesome Claude Code" />
                  </a>
                )}{' '}
                {project.count}
              </h6>
              <p class="card-text">{project.text}</p>
              <a href={project.url} class="card-link">
                View on {host(project.url)}
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
