---
import '../components/site-style/tokens.css';
import ThemeScript from '../components/site-style/ThemeScript.astro';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import career from '../components/site-career/career.json';
import profile from '../components/site-footer/profile.json';
import { hubGraph } from '../components/site-seo/graph.mjs';
import { ogImagePath } from '../components/site-seo/card.mjs';
import { PAGES } from '../page-meta';

interface Props {
  page?: keyof typeof PAGES;
}

const { page = 'index' } = Astro.props;
const { title, card, description } = PAGES[page];

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImagePath(Astro.url.pathname, '/'), Astro.site);
// The Person node the other sites point at (D-009)
const graph = hubGraph({
  career,
  profile,
  knowsAbout: ['SOC 2', 'HIPAA', 'FERPA', 'data engineering', 'security engineering'],
  page: { url: canonical.href, title, description, isHome: Astro.url.pathname === '/' },
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <ThemeScript />
  <meta name="google-site-verification" content="F01KE0U-EHMrEHtYf5nOpt5tlbWeoMoil6Wkp0x5ONQ" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QS4KFCN3S4"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QS4KFCN3S4');
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles/base.css" />
  <link rel="stylesheet" href="/styles/main.css" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Seo
    title={title}
    description={description}
    canonical={canonical}
    ogImage={image.href}
    ogImageAlt={card}
    ogImageWidth={1200}
    ogImageHeight={630}
    siteName="Jeff Smolinski"
    twitter={{ card: 'summary_large_image' }}
    graph={graph}
  />
</head>

<body id="PageTop">
  <slot />
</body>
</html>
